{
  "realm": "chambo",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "client": {
      "Chambo-API-ID": [
        { "name": "Admin" },
        { "name": "Supervisor" },
        { "name": "Tagger" }
      ]
    }
  },
  "clients": [
    {
      "clientId": "Chambo-API-ID",
      "name": "Chambo API",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "chambo-frontend",
      "name": "Chambo Frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:5173/*", "http://localhost:5000/*"],
      "webOrigins": ["http://localhost:5173", "http://localhost:5000"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "chambo-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "Chambo-API-ID",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin@chambo.local",
      "email": "admin@chambo.local",
      "firstName": "Chambo",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "admin", "temporary": false }],
      "clientRoles": { "Chambo-API-ID": ["Admin"] }
    },
    {
      "username": "tagger@chambo.local",
      "email": "tagger@chambo.local",
      "firstName": "Chambo",
      "lastName": "Tagger",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "tagger", "temporary": false }],
      "clientRoles": { "Chambo-API-ID": ["Tagger"] }
    }
  ]
}
