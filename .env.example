# JWT Settings
JwtSettings__SecretKey=
JwtSettings__Issuer=
JwtSettings__Audience=
JwtSettings__ExpiryMinutes=

# Azure Entra ID (Azure AD) authentication — optional, alongside local JWT login.
# Leave TenantId/ClientId empty to keep Entra ID authentication disabled.
EntraId__Instance=https://login.microsoftonline.com/
EntraId__TenantId=
EntraId__ClientId=
EntraId__Audience=
EntraId__RoleClaimType=roles

# Database Settings
Database__Provider=
Database__Host=
Database__Port=
Database__Name=
Database__Username=
Database__Password=
Database__DataSource=

# Storage Settings
Storage__Provider=
Storage__FileStorageRoot=

## S3 / S3-compatible storage (MinIO, SeaweedFS, LocalStack, etc.)
Storage__S3__ServiceUrl=
Storage__S3__BucketName=
Storage__S3__AccessKey=
Storage__S3__SecretKey=
Storage__S3__ForcePathStyle=true

## Azure Blob Storage
Storage__AzureStorage__ConnectionString=
Storage__AzureStorage__ContainerName=

# Default Admin User
DefaultAdmin__Username=
DefaultAdmin__Email=
DefaultAdmin__Password=

# Default Tagger User
DefaultTagger__Username=
DefaultTagger__Email=
DefaultTagger__Password=

# Default Supervisor User
DefaultSupervisor__Username=
DefaultSupervisor__Email=
DefaultSupervisor__Password=

# Cors Settings
Cors__AllowedOrigins_0=http://localhost:5000
Cors__AllowedOrigins_1=http://localhost:5173