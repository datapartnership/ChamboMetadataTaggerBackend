# Authentication method: Jwt | EntraId | Keycloak
# Only the selected method is registered; nested EntraId/Keycloak/JwtSettings
# values for other providers are ignored until you switch Method.
Authentication__Method=Jwt

# JWT Settings (required when Authentication__Method=Jwt)
JwtSettings__SecretKey=
JwtSettings__Issuer=
JwtSettings__Audience=
# Defaults to 480 when unset
# JwtSettings__ExpiryMinutes=480

# Azure Entra ID (Azure AD) authentication — used when Authentication__Method=EntraId.
EntraId__Instance=https://login.microsoftonline.com/
EntraId__TenantId=
EntraId__ClientId=
EntraId__Audience=
EntraId__RoleClaimType=roles

# Keycloak authentication — used when Authentication__Method=Keycloak.
Keycloak__Authority=
Keycloak__Audience=
Keycloak__ClientId=
Keycloak__RequireHttpsMetadata=true
# Optional role mapping; leave commented unless both values are set (blank values fail startup)
# Keycloak__RoleMappings__0__KeycloakRole=
# Keycloak__RoleMappings__0__Role=

# Database Settings
Database__Host=
Database__Port=
Database__Name=
Database__Username=
Database__Password=
# Database__UseManagedIdentity=false
# Database__ManagedIdentityClientId=
# true = drop every table and rebuild the schema on startup (all data lost on each restart)
Database__ResetOnStartup=false

# MertBlobStorage (docker-compose). Account name + base64 key shared by the storage
# container and the API; docker-compose.yml builds the Azure connection string from them.
MertBlob__AccountName=chambo
MertBlob__AccountKey=

# Catalog storage — one bucket/container laid out as Provider/CollectionFolder. Taggers work
# on these files, POST /api/seed scans them, and the catalog API serves them.
# Provider is "local", "s3", or "azure". Preview URLs (SAS / presigned) need "s3" or "azure".
CatalogStorage__Provider=azure
CatalogStorage__Azure__ServiceUri=
CatalogStorage__Azure__ContainerName=
# Blob key prefix before Provider/Collection (e.g. markdown/CATALOGPROD). Empty = container root.
CatalogStorage__Azure__Prefix=
CatalogStorage__Azure__ManagedIdentityClientId=
CatalogStorage__FileStorageRoot=
CatalogStorage__S3__ServiceUrl=
CatalogStorage__S3__BucketName=
CatalogStorage__S3__AccessKey=
CatalogStorage__S3__SecretKey=
CatalogStorage__S3__ForcePathStyle=false
# CatalogStorage__S3__Region=us-east-1
CatalogStorage__Azure__ConnectionString=


# Catalog API daily download rate limit (0 = unlimited)
RateLimit__DailyFileDownloadLimit=0

# Default Admin User
DefaultAdmin__Username=
DefaultAdmin__Email=
DefaultAdmin__Password=

# Default Tagger User
DefaultTagger__Username=
DefaultTagger__Email=
DefaultTagger__Password=

# Default Supervisor User
DefaultSupervisor__Username=
DefaultSupervisor__Email=
DefaultSupervisor__Password=

# Cors Settings
Cors__AllowedOrigins__0=http://localhost:5000
Cors__AllowedOrigins__1=http://localhost:5173
